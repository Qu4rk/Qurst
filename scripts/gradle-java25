#!/bin/sh
# Run this project's Gradle wrapper with a Java 25 JDK.
set -eu
project_dir=$(CDPATH= cd "$(dirname "$0")/.." && pwd)

if [ -z "${JAVA_HOME:-}" ] && [ -x /usr/libexec/java_home ]; then
    JAVA_HOME=$(/usr/libexec/java_home -v 25 2>/dev/null || true)
fi
if [ -z "${JAVA_HOME:-}" ]; then
    for candidate in "$HOME"/.cache/bosonq/java25/*/Contents/Home; do
        if [ -x "$candidate/bin/javac" ]; then
            JAVA_HOME=$candidate
            break
        fi
    done
fi
if [ -z "${JAVA_HOME:-}" ] || [ ! -x "$JAVA_HOME/bin/javac" ]; then
    echo 'Java 25 JDK required. Install one and set JAVA_HOME to its directory.' >&2
    exit 1
fi
export JAVA_HOME
cd "$project_dir"
exec ./gradlew "$@"
